{
  "name": "terrace-player",
  "version": "1.0.0",
  "description": "Local image and video player with seamless fullscreen shortcuts",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:web": "vite --host 127.0.0.1",
    "start": "electron .",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.cjs",
    "test:electron": "npm run build && node scripts/smoke.cjs",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.46.1",
    "vite": "^6.4.1"
  },
  "build": {
    "appId": "com.terrace.player",
    "productName": "Terrace Player",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
